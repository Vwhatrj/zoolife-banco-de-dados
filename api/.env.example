# Copie para .env e preencha com o usuário do banco criado para a API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zoolife_api
DB_PASSWORD=troque-esta-senha
DB_NAME=clinica

# Chave que assina os tokens de login. Use um texto longo e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRA_MINUTOS=60
